<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/fallbackPillBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/canvas_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hostPill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/bg_top_pill"
            android:clickable="true"
            android:contentDescription="@string/switch_host"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <View
                android:id="@+id/pillStatusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/pillHostName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_hairline" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sessionPane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/coverPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/canvas_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <FrameLayout
                android:id="@+id/coverIconTile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_emblem_tile">

                <ImageView
                    android:id="@+id/coverIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_codexhost_mark" />
            </FrameLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/coverProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                app:indicatorColor="@color/brand_emerald"
                app:indicatorSize="28dp"
                app:trackColor="@color/surface_subtle"
                app:trackThickness="3dp" />

            <TextView
                android:id="@+id/coverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/session_connecting"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/coverMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/connecting_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    style="@style/Widget.Codexhost.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/retry"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switchCoverButton"
                    style="@style/Widget.Codexhost.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/switch_host" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
