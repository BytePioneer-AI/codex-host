<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Codexhost" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/canvas_bg</item>
        <item name="colorPrimary">@color/brand_emerald</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_emerald_tint</item>
        <item name="colorOnPrimaryContainer">@color/brand_emerald_text</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorSecondaryContainer">@color/surface_subtle</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_strong</item>
        <item name="colorOutlineVariant">@color/border_hairline</item>
        <item name="colorError">@color/error_red</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Codexhost.AlertDialog</item>
    </style>

    <style name="ShapeAppearance.Codexhost.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ThemeOverlay.Codexhost.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Codexhost.Dialog</item>
    </style>

    <style name="Widget.Codexhost.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_fg</item>
        <item name="iconTint">@color/btn_primary_fg</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Codexhost.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface_card</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Codexhost.Button.IconTonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="backgroundTint">@color/surface_subtle</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Codexhost.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">@color/text_input_hint</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
    </style>
</resources>
