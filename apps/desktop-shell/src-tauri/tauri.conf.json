{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexHost",
  "version": "0.24.0",
  "identifier": "com.codexhost.shell",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["embedded-pages"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/tray.png"] }
}
