{
  "name": "@deepseek-ai/dsh-api-terminal-controller",
  "version": "0.2.2-alpha.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "import:protocol": "node scripts/import-protocol.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./host/typert.host.d.ts",
      "default": "./host/typert.host.js"
    },
    "./remote": {
      "types": "./generated/remote.d.ts",
      "default": "./generated/remote.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection"
      ],
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "platform": "web"
    }
  }
}
