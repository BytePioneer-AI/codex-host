{
  "name": "@deepseek-ai/dsh-api-workspace-controller",
  "version": "0.2.1-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./default-workspace": {
      "types": "./src/default-workspace.ts",
      "default": "./src/default-workspace.ts"
    },
    "./typert": {
      "types": "./src/typert.host.ts",
      "default": "./src/typert.host.ts"
    },
    "./remote": {
      "types": "./generated/remote.d.ts",
      "default": "./generated/remote.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "zod": "^4.4.3"
  },
  "dsh": {
    "client": {
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
