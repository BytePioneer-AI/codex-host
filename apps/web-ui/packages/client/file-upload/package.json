{
  "name": "@deepseek-ai/dsh-client-file-upload",
  "version": "0.2.1-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./typert": {
      "types": "./src/typert.host.ts",
      "default": "./src/typert.host.ts"
    },
    "./remote": {
      "types": "./generated/remote.d.ts",
      "default": "./generated/remote.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-util-crypto": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
