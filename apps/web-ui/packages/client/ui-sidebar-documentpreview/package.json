{
  "name": "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
  "version": "0.2.1-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
