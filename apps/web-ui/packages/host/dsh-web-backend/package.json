      "types": "./lib/stream-input.d.ts",
      "default": "./src/stream-input.ts"
    },
    "./client-assets": {
      "types": "./lib/client-assets.d.ts",
      "default": "./src/client-assets.ts"
    },
    "./plugin-bundles": {
      "types": "./lib/plugin-bundles.d.ts",
