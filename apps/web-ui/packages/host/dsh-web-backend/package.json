{
  "name": "@codexhost/dsh-web-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./src/index.ts"
    },
