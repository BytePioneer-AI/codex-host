{
  "name": "@deepseek-ai/dsh-subprocess-local",
  "version": "0.2.1-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
