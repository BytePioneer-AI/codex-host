{
  "manifestVersion": 1,
  "id": "devin",
  "name": "Devin",
  "version": "0.0.0",
  "adapterApiVersion": 1,
  "entry": "./dist/plugin.js",
  "icon": "./assets/icon.svg",
  "installation": {
    "commands": [
      {
        "terminal": "macOS / Linux · Terminal (sh/bash)",
        "command": "curl -fsSL https://cli.devin.ai/install.sh | bash"
      },
      {
        "terminal": "Windows · PowerShell",
        "command": "irm https://cli.devin.ai/install.ps1 | iex"
      }
    ],
    "after": {
      "en": "After installation, run devin auth login to complete login or setup.",
      "zh-CN": "安装后运行 devin auth login，完成登录或配置。"
    }
  },
  "links": {
    "website": "https://devin.ai/",
    "documentation": "https://docs.devin.ai/cli",
    "installation": "https://docs.devin.ai/cli"
  }
}
