{
  "manifestVersion": 1,
  "id": "opencode",
  "name": "OpenCode",
  "version": "0.0.0",
  "adapterApiVersion": 1,
  "entry": "./dist/plugin.js",
  "icon": "./assets/icon.svg",
  "links": {
    "website": "https://opencode.ai/",
    "installation": "https://opencode.ai/docs/#install"
  },
  "installation": {
    "commands": [
      {
        "terminal": "macOS / Linux / Windows · Terminal / PowerShell",
        "command": "npm install -g @opencode/cli"
      }
    ],
    "before": {
      "en": "Requires Node.js (including npm).",
      "zh-CN": "需先安装 Node.js（包含 npm）。"
    },
    "after": {
      "en": "After installation, run opencode to complete login or setup.",
      "zh-CN": "安装后运行 opencode，完成登录或配置。"
    }
  },
  "iconStyle": {
    "vector": {
      "viewBox": "0 0 74 74",
      "color": "#FFFFFF",
      "paths": [
        {
          "d": "M5 5H69V69H5Z",
          "fill": "#131010"
        },
        {
          "d": "M21 17H53V57H21ZM29 25V49H45V25Z",
          "fillRule": "evenodd",
          "fill": "#FFFFFF"
        },
        {
          "d": "M29 33H45V49H29Z",
          "fill": "#5A5858"
        }
      ]
    }
  }
}
