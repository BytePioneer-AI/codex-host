{
  "manifestVersion": 1,
  "id": "pi",
  "name": "Pi",
  "version": "0.0.0",
  "adapterApiVersion": 1,
  "entry": "./dist/plugin.js",
  "icon": "./assets/icon.svg",
  "iconStyle": { "monochrome": true },
  "links": { "website": "https://pi.dev/", "installation": "https://pi.dev/" },
  "installation": {
    "commands": [
      {
        "terminal": "macOS / Linux · Terminal (sh/bash)",
        "command": "curl -fsSL https://pi.dev/install.sh | sh"
      },
      { "terminal": "Windows · PowerShell", "command": "irm https://pi.dev/install.ps1 | iex" }
    ],
    "after": {
      "en": "After installation, run pi to complete login or setup.",
      "zh-CN": "安装后运行 pi，完成登录或配置。"
    }
  }
}
