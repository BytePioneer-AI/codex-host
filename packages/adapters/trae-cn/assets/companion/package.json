{
  "name": "trae-cn-bridge",
  "publisher": "codexhost",
  "displayName": "CodexHost TRAE CN Bridge",
  "description": "Connect CodexHost to the native Agent in TRAE CN Desktop.",
  "version": "0.1.9",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/BytePioneer-AI/codex-host.git"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "main": "./extension.cjs",
  "files": [
    "*.cjs",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexhost.traeCn.restartBridge",
        "title": "CodexHost: Restart TRAE CN Bridge"
      }
    ]
  }
}
