{
  "name": "@codexhost/adapter-trae-cn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
