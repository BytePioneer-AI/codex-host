  },
  "dependencies": {
    "@codexhost/harness-adapter": "0.0.0",
    "@codexhost/harness-discovery": "0.0.0",
    "@codexhost/shared-contracts": "0.0.0",
    "diff": "8.0.2"
  },
  "files": [
    "dist",
    "manifest.json",
    "assets",
    "CAPABILITIES.md"
  ],
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "yauzl": "3.4.0"
  }
}
