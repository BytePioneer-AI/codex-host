{
  "name": "@codexhost/desktop-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./production-controller": {
      "types": "./dist/production-controller.d.ts",
      "import": "./dist/production-controller.js"
    },
    "./renderer-bindings": {
      "types": "./dist/renderer-bindings.d.ts",
