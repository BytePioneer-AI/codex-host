+//! Per-connection standard protocol conversion. No Harness routing or raw reply bypass.
+use codex_app_server_protocol::{
+    ClientRequest, ClientResponse, ExperimentalApi, InitializeCapabilities, JSONRPCErrorError,
+    JSONRPCMessage, RequestId, ServerNotification, ServerNotificationEnvelope, ServerRequest,
+};
+use codex_app_server_transport::{OutgoingError, OutgoingMessage, OutgoingResponse};
+use std::collections::{HashMap, HashSet};
+use std::io;
+
+const MAX_PENDING: usize = 128;
+
+pub(super) enum Input {
+    Host(String),
+    Reply(OutgoingMessage),
+}
+
+#[derive(Default)]
+pub(super) struct Codec {
+    requests: HashMap<RequestId, String>,
+    server_requests: HashSet<RequestId>,
+    initializing: Option<(RequestId, InitializeCapabilities)>,
+    pub ready: bool,
+    pub capabilities: InitializeCapabilities,
+}
+
+fn reject(id: RequestId, code: i64, message: &str) -> Input {
+    Input::Reply(OutgoingMessage::Error(OutgoingError {
+        id,
+        error: JSONRPCErrorError {
+            code,
+            message: message.to_owned(),
+            data: None,
+        },
+    }))
+}
+
+impl Codec {
+    pub fn incoming(&mut self, message: JSONRPCMessage) -> io::Result<Input> {
+        match &message {
+            JSONRPCMessage::Request(request) => {
+                if self.requests.contains_key(&request.id) || self.requests.len() >= MAX_PENDING {
+                    return Err(io::Error::other(
+                        "remote request ledger limit or duplicate ID",
+                    ));
+                }
+                let typed = match ClientRequest::try_from(request.clone()) {
+                    Ok(typed) => typed,
+                    Err(_) => {
+                        return Ok(reject(
+                            request.id.clone(),
+                            -32600,
+                            "Unsupported or invalid standard request",
+                        ));
+                    }
+                };
+                if let ClientRequest::Initialize { params, .. } = typed {
+                    if self.ready || self.initializing.is_some() {
+                        return Ok(reject(
+                            request.id.clone(),
+                            -32600,
+                            "Already initialized or initializing",
+                        ));
+                    }
+                    self.initializing =
+                        Some((request.id.clone(), params.capabilities.unwrap_or_default()));
+                } else {
+                    if !self.ready {
+                        return Ok(reject(request.id.clone(), -32600, "Not initialized"));
+                    }
+                    if typed.experimental_reason().is_some() && !self.capabilities.experimental_api
+                    {
+                        return Ok(reject(
+                            request.id.clone(),
+                            -32600,
+                            "Experimental API capability required",
+                        ));
+                    }
+                }
+                self.requests
+                    .insert(request.id.clone(), request.method.clone());
+            }
+            JSONRPCMessage::Response(response) => {
+                self.server_requests.remove(&response.id);
+            }
+            JSONRPCMessage::Error(error) => {
+                self.server_requests.remove(&error.id);
+            }
+            JSONRPCMessage::Notification(_) => {}
+        }
+        serde_json::to_string(&message)
+            .map(Input::Host)
+            .map_err(io::Error::other)
+    }
+
+    pub fn outgoing(&mut self, frame: &str) -> io::Result<Option<OutgoingMessage>> {
+        let message: JSONRPCMessage = serde_json::from_str(frame).map_err(io::Error::other)?;
+        let outgoing = match message {
+            JSONRPCMessage::Response(response) => {
+                let method = self
+                    .requests
+                    .get(&response.id)
+                    .ok_or_else(|| io::Error::other("uncorrelated Host response"))?;
+                let response: ClientResponse = serde_json::from_value(serde_json::json!({
+                    "id": response.id, "method": method, "response": response.result,
+                }))
+                .map_err(io::Error::other)?;
+                let (id, payload) = response.into_payload();
+                // Decode fully before consuming the ledger or committing capabilities.
+                self.requests.remove(&id);
+                if self
+                    .initializing
+                    .as_ref()
+                    .is_some_and(|(pending, _)| *pending == id)
+                {
+                    let (_, capabilities) = self.initializing.take().expect("checked initialize");
+                    self.capabilities = capabilities;
+                    self.ready = true;
+                }
+                OutgoingMessage::Response(OutgoingResponse {
+                    id,
+                    result: Box::new(payload),
+                })
+            }
+            JSONRPCMessage::Error(error) => {
+                if self.requests.remove(&error.id).is_none() {
+                    return Err(io::Error::other("uncorrelated Host error"));
+                }
+                if self
+                    .initializing
+                    .as_ref()
+                    .is_some_and(|(id, _)| *id == error.id)
+                {
+                    self.initializing = None;
+                }
+                OutgoingMessage::Error(OutgoingError {
+                    id: error.id,
+                    error: error.error,
+                })
+            }
+            JSONRPCMessage::Request(request) => {
+                if !self.ready {
+                    return Err(io::Error::other("Host request before initialize response"));
+                }
+                let typed: ServerRequest = serde_json::from_str(frame).map_err(io::Error::other)?;
+                if self.server_requests.len() >= MAX_PENDING
+                    || !self.server_requests.insert(request.id)
+                {
+                    return Err(io::Error::other(
+                        "Host request ledger limit or duplicate ID",
+                    ));
+                }
+                OutgoingMessage::Request(typed)
+            }
+            JSONRPCMessage::Notification(notification) => {
+                // Host extension notifications have no representation in the official client.
+                // Never suppress an unknown standard notification or a server request.
+                if notification.method.starts_with("codexhost/") {
+                    return Ok(None);
+                }
+                if !self.ready {
+                    return Err(io::Error::other(
+                        "Host notification before initialize response",
+                    ));
+                }
+                let typed: ServerNotificationEnvelope =
+                    serde_json::from_str(frame).map_err(io::Error::other)?;
+                if let ServerNotification::ServerRequestResolved(resolved) = &typed.notification {
+                    self.server_requests.remove(&resolved.request_id);
+                }
+                OutgoingMessage::AppServerNotification(typed)
+            }
+        };
+        Ok(Some(outgoing))
+    }
+}
