+#[tokio::test]
+async fn writer_filters_closed_gate_and_bounds_backpressure() {
+    let (writer, mut rx) = mpsc::channel(1);
+    let outbound = OutboundConnectionState::new(
+        writer,
+        Arc::new(AtomicBool::new(true)),
+        Arc::new(AtomicBool::new(false)),
+        Arc::new(RwLock::new(HashSet::new())),
+        None,
+    );
+    let gate = ConnectionRpcGate::new();
+    let error = || {
+        OutgoingMessage::Error(codex_app_server_transport::OutgoingError {
+            id: RequestId::Integer(1),
+            error: codex_app_server_protocol::JSONRPCErrorError {
+                code: -32600,
+                message: "test".into(),
+                data: None,
+            },
+        })
+    };
+    send(&outbound, error(), &gate).unwrap();
+    assert!(send(&outbound, error(), &gate).is_err());
+    rx.recv().await.unwrap();
+    gate.close().await;
+    assert!(send(&outbound, error(), &gate).is_err());
+}
