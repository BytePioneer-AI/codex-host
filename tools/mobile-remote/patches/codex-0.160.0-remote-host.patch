+#[tokio::test]
+async fn real_unix_host_roundtrip_preserves_initialize_order_and_native_reply() {
+    let dir = tempfile::tempdir().unwrap();
+    std::fs::set_permissions(dir.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+    let path = dir.path().join("host.sock");
+    let listener = tokio::net::UnixListener::bind(&path).unwrap();
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).unwrap();
+    let host = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut socket = tokio_tungstenite::accept_async(stream).await.unwrap();
+        let frame = socket.next().await.unwrap().unwrap().into_text().unwrap();
+        assert!(!frame.ends_with('\n'));
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&frame).unwrap()["method"],
+            "initialize"
+        );
+        socket.send(Message::Text(json!({"id":1,"result":{"userAgent":"Host","codexHome":"/tmp/probe","platformFamily":"unix","platformOs":"macos"}}).to_string().into())).await.unwrap();
+        let frame = socket.next().await.unwrap().unwrap().into_text().unwrap();
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&frame).unwrap()["method"],
+            "thread/name/set"
+        );
+        socket
+            .send(Message::Text(
+                json!({"id":2,"result":{}}).to_string().into(),
+            ))
+            .await
+            .unwrap();
+        let _ = socket.next().await;
+    });
+    let (tx, incoming) = mpsc::channel(4);
+    let (writer, mut replies) = mpsc::channel(4);
+    let worker =
+        tokio::spawn(
+            async move { forward(&path, incoming, writer, &ConnectionRpcGate::new()).await },
+        );
+    tx.send(message(
+        json!({"id":1,"method":"initialize","params":{"clientInfo":{"name":"test","version":"1"}}}),
+    ))
+    .await
+    .unwrap();
+    let first = timeout(Duration::from_secs(5), replies.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(serde_json::to_value(first.message).unwrap()["id"], 1);
+    tx.send(message(
+        json!({"id":2,"method":"thread/name/set","params":{"threadId":"synthetic","name":"new"}}),
+    ))
+    .await
+    .unwrap();
+    let second = timeout(Duration::from_secs(5), replies.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(second.message).unwrap(),
+        json!({"id":2,"result":{}})
+    );
+    drop(tx);
+    timeout(Duration::from_secs(5), worker)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    timeout(Duration::from_secs(5), host)
+        .await
+        .unwrap()
+        .unwrap();
+}
