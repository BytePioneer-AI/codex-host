+use super::*;
+use codex_app_server_protocol::RequestId;
+use serde_json::json;
+
+fn message(value: serde_json::Value) -> JSONRPCMessage {
+    serde_json::from_value(value).unwrap()
+}
+fn initialize(codec: &mut Codec) {
+    codec.incoming(message(json!({"id":1,"method":"initialize","params":{"clientInfo":{"name":"test","version":"1"}}}))).unwrap();
+    codec.outgoing(&json!({"id":1,"result":{"userAgent":"test","codexHome":"/tmp/probe","platformFamily":"unix","platformOs":"macos"}}).to_string()).unwrap();
+}
+
+#[test]
+fn disabled_forwarder_preserves_every_native_event() {
+    let mut forwarder = RemoteHostForwarder {
+        endpoint: None,
+        connections: HashMap::new(),
+        tasks: JoinSet::new(),
+    };
+    assert!(matches!(
+        forwarder.route(TransportEvent::DaemonShutdown),
+        Some(TransportEvent::DaemonShutdown)
+    ));
+    assert!(matches!(
+        forwarder.route(TransportEvent::IncomingMessage {
+            connection_id: ConnectionId(1),
+            message: message(json!({"id":1,"method":"thread/list","params":{}}))
+        }),
+        Some(TransportEvent::IncomingMessage { .. })
+    ));
+}
+
+#[tokio::test]
+async fn only_authenticated_remote_connections_are_forwarded() {
+    let mut forwarder = RemoteHostForwarder {
+        endpoint: Some(PathBuf::from("/nonexistent/host.sock")),
+        connections: HashMap::new(),
+        tasks: JoinSet::new(),
+    };
+    for origin in [
+        ConnectionOrigin::Stdio,
+        ConnectionOrigin::WebSocket,
+        ConnectionOrigin::InProcess,
+    ] {
+        let (writer, _rx) = mpsc::channel(1);
+        assert!(matches!(
+            forwarder.route(TransportEvent::ConnectionOpened {
+                connection_id: ConnectionId(1),
+                origin,
+                auth: None,
+                writer,
+                disconnect_sender: None
+            }),
+            Some(TransportEvent::ConnectionOpened { .. })
+        ));
+    }
+    let cancel = CancellationToken::new();
+    let (writer, _rx) = mpsc::channel(1);
+    assert!(
+        forwarder
+            .route(TransportEvent::ConnectionOpened {
+                connection_id: ConnectionId(2),
+                origin: ConnectionOrigin::RemoteControl,
+                auth: None,
+                writer,
+                disconnect_sender: Some(cancel.clone())
+            })
+            .is_none()
+    );
+    assert!(cancel.is_cancelled());
+    assert!(forwarder.connections.is_empty());
+}
+
+#[test]
+fn all_standard_responses_use_generated_method_conversion() {
+    let mut codec = Codec::default();
+    initialize(&mut codec);
+    // This method was unsupported by the earlier six-method prototype.
+    assert!(matches!(codec.incoming(message(json!({"id":2,"method":"thread/name/set","params":{"threadId":"synthetic","name":"renamed"}}))).unwrap(), Input::Host(_)));
+    let reply = codec.outgoing(r#"{"id":2,"result":{}}"#).unwrap().unwrap();
+    assert_eq!(
+        serde_json::to_value(reply).unwrap(),
+        json!({"id":2,"result":{}})
+    );
+}
+
+#[test]
+fn decode_failure_keeps_ledger_and_connection_ledgers_are_independent() {
+    let mut a = Codec::default();
+    let mut b = Codec::default();
+    initialize(&mut a);
+    initialize(&mut b);
+    for codec in [&mut a, &mut b] {
+        codec
+            .incoming(message(json!({"id":3,"method":"thread/list","params":{}})))
+            .unwrap();
+    }
+    assert!(a.outgoing(r#"{"id":3,"result":{"data":42}}"#).is_err());
+    assert!(
+        a.outgoing(r#"{"id":3,"result":{"data":[],"nextCursor":null}}"#)
+            .is_ok()
+    );
+    assert!(
+        b.outgoing(r#"{"id":3,"result":{"data":[],"nextCursor":null}}"#)
+            .is_ok()
+    );
+    assert!(
+        a.outgoing(r#"{"id":3,"result":{"data":[],"nextCursor":null}}"#)
+            .is_err()
+    );
+}
+
+#[test]
+fn handshake_and_experimental_capabilities_are_enforced() {
+    let mut codec = Codec::default();
+    assert!(matches!(
+        codec
+            .incoming(message(json!({"id":9,"method":"thread/list","params":{}})))
+            .unwrap(),
+        Input::Reply(_)
+    ));
+    assert!(
+        codec
+            .outgoing(r#"{"method":"thread/started","params":{}}"#)
+            .is_err()
+    );
+    initialize(&mut codec);
+    assert!(matches!(
+        codec
+            .incoming(message(
+                json!({"id":2,"method":"remoteControl/status/read","params":{}})
+            ))
+            .unwrap(),
+        Input::Reply(_)
+    ));
+    assert!(matches!(
+        codec
+            .incoming(message(
+                json!({"id":3,"method":"codexhost/private","params":{}})
+            ))
+            .unwrap(),
+        Input::Reply(_)
+    ));
+}
