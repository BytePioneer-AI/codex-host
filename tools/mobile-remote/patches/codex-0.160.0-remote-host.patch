+//! Optional Remote-Control-only Host endpoint. Native transports keep their own processor.
+//! Each remote connection has independent bounded I/O; the app-server event loop never waits
+//! for a Host RPC (which can itself call the native WebSocket on this app-server).
+use crate::connection_rpc_gate::ConnectionRpcGate;
+use crate::transport::{
+    OutboundConnectionState, filter_outgoing_message_for_connection,
+    should_skip_notification_for_connection,
+};
+use codex_app_server_protocol::JSONRPCMessage;
+use codex_app_server_transport::{
+    ConnectionAuth, ConnectionId, ConnectionOrigin, OutgoingMessage, QueuedOutgoingMessage,
+    TransportEvent,
+};
+use futures::{SinkExt, StreamExt};
+use std::collections::{HashMap, HashSet};
+use std::io;
+use std::os::unix::fs::{FileTypeExt, MetadataExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::{
+    Arc, RwLock,
+    atomic::{AtomicBool, Ordering},
+};
+use std::time::Duration;
+use tokio::net::UnixStream;
+use tokio::sync::mpsc;
+use tokio::task::JoinSet;
+use tokio::time::timeout;
+use tokio_tungstenite::tungstenite::{Message, protocol::WebSocketConfig};
+use tokio_util::sync::CancellationToken;
+
+#[path = "remote_host_codec.rs"]
+mod codec;
+use codec::{Codec, Input};
+
+const ENDPOINT_ENV: &str = "CODEXHOST_REMOTE_HOST_SOCKET";
+const QUEUE_CAPACITY: usize = 128;
+// Match app-server-transport Remote Control reassembly, including large histories.
+const MAX_FRAME: usize = 100 * 1024 * 1024;
+const IO_DEADLINE: Duration = Duration::from_secs(10);
+
+struct Connection {
+    incoming: mpsc::Sender<JSONRPCMessage>,
+    cancel: CancellationToken,
+}
+
+pub(crate) struct RemoteHostForwarder {
+    endpoint: Option<PathBuf>,
+    connections: HashMap<ConnectionId, Connection>,
+    tasks: JoinSet<()>,
+}
+
+impl RemoteHostForwarder {
+    pub fn from_env() -> io::Result<Self> {
+        let endpoint = std::env::var_os(ENDPOINT_ENV).map(PathBuf::from);
+        if let Some(path) = &endpoint {
+            if !path.is_absolute() {
+                return Err(io::Error::other("Remote Host socket must be absolute"));
+            }
+        }
+        Ok(Self {
+            endpoint,
+            connections: HashMap::new(),
+            tasks: JoinSet::new(),
+        })
+    }
+
+    /// Returns only events belonging to the native processor. No async I/O here.
+    pub fn route(&mut self, event: TransportEvent) -> Option<TransportEvent> {
+        let Some(endpoint) = self.endpoint.as_ref() else {
+            return Some(event);
+        };
+        while self.tasks.try_join_next().is_some() {}
+        match event {
+            TransportEvent::ConnectionOpened {
+                connection_id,
+                origin: ConnectionOrigin::RemoteControl,
+                auth,
+                writer,
+                disconnect_sender,
+            } => {
+                let Some(cancel) = disconnect_sender else {
+                    return None;
+                };
+                let Some(auth) = auth.filter(ConnectionAuth::is_current) else {
+                    cancel.cancel();
+                    return None;
+                };
+                if self.connections.len() >= QUEUE_CAPACITY
+                    || self.connections.contains_key(&connection_id)
+                {
+                    cancel.cancel();
+                    return None;
+                }
+                let (incoming, receiver) = mpsc::channel(QUEUE_CAPACITY);
+                self.connections.insert(
+                    connection_id,
+                    Connection {
+                        incoming,
+                        cancel: cancel.clone(),
+                    },
+                );
+                let endpoint = endpoint.clone();
+                self.tasks.spawn(async move {
+                    let mut gate = ConnectionRpcGate::new();
+                    gate.auth = Some(auth);
+                    tokio::select! {
+                        biased;
+                        _ = cancel.cancelled() => {},
+                        result = forward(&endpoint, receiver, writer, &gate) => {
+                            if result.is_err() {
+                                // Payloads, local paths and credentials must not enter diagnostics.
+                                tracing::warn!(%connection_id, "Remote Host connection ended; no native fallback");
+                            }
+                        }
+                    }
+                    gate.close().await;
+                    cancel.cancel();
+                });
+                None
+            }
+            TransportEvent::IncomingMessage {
+                connection_id,
+                message,
+            } => {
+                if let Some(connection) = self.connections.get(&connection_id) {
+                    if connection.incoming.try_send(message).is_err() {
+                        connection.cancel.cancel();
+                    }
+                    None
+                } else {
+                    Some(TransportEvent::IncomingMessage {
+                        connection_id,
+                        message,
+                    })
+                }
+            }
+            TransportEvent::ConnectionClosed { connection_id } => {
+                if let Some(connection) = self.connections.remove(&connection_id) {
+                    connection.cancel.cancel();
+                    None
+                } else {
+                    Some(TransportEvent::ConnectionClosed { connection_id })
+                }
+            }
+            event => Some(event),
+        }
+    }
+}
+
+impl Drop for RemoteHostForwarder {
+    fn drop(&mut self) {
+        for connection in self.connections.values() {
+            connection.cancel.cancel();
+        }
+        self.tasks.abort_all();
+    }
+}
+
+fn validate_endpoint(path: &Path) -> io::Result<()> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    let parent = std::fs::symlink_metadata(
+        path.parent()
+            .ok_or_else(|| io::Error::other("missing socket parent"))?,
+    )?;
+    if !metadata.file_type().is_socket()
+        || metadata.permissions().mode() & 0o077 != 0
+        || !parent.is_dir()
+        || parent.permissions().mode() & 0o077 != 0
+        || metadata.uid() != parent.uid()
+    {
+        return Err(io::Error::other(
+            "Remote Host socket and its directory must be private and share an owner",
+        ));
+    }
+    Ok(())
+}
+
+// The official backend starts before the shared Host has completed plugin loading.
+// Retry only a not-yet-listening private endpoint, within the same bounded admission.
+async fn connect_endpoint(endpoint: &Path) -> io::Result<UnixStream> {
+    timeout(IO_DEADLINE, async {
+        loop {
+            let result = match validate_endpoint(endpoint) {
+                Ok(()) => UnixStream::connect(endpoint).await,
+                Err(error) => Err(error),
+            };
+            match result {
+                Ok(stream) => {
+                    if stream.peer_cred()?.uid() != std::fs::symlink_metadata(endpoint)?.uid() {
+                        return Err(io::Error::other("Remote Host peer owner changed"));
+                    }
+                    return Ok(stream);
+                }
+                Err(error)
+                    if matches!(
+                        error.kind(),
+                        io::ErrorKind::NotFound | io::ErrorKind::ConnectionRefused
+                    ) =>
+                {
+                    tokio::time::sleep(Duration::from_millis(25)).await;
+                }
+                Err(error) => return Err(error),
+            }
+        }
+    })
+    .await?
+}
+
+async fn forward(
+    endpoint: &Path,
+    mut incoming: mpsc::Receiver<JSONRPCMessage>,
+    writer: mpsc::Sender<QueuedOutgoingMessage>,
+    gate: &ConnectionRpcGate,
+) -> io::Result<()> {
+    let stream = connect_endpoint(endpoint).await?;
+    let config = WebSocketConfig::default()
+        .max_message_size(Some(MAX_FRAME))
+        .max_frame_size(Some(MAX_FRAME));
+    let (socket, _) = timeout(
+        IO_DEADLINE,
+        tokio_tungstenite::client_async_with_config("ws://localhost/", stream, Some(config)),
+    )
+    .await?
+    .map_err(io::Error::other)?;
+    let (mut sink, mut source) = socket.split();
+    let initialized = Arc::new(AtomicBool::new(false));
+    let experimental = Arc::new(AtomicBool::new(false));
+    let opt_out = Arc::new(RwLock::new(HashSet::new()));
+    let outbound = OutboundConnectionState::new(
+        writer,
+        initialized.clone(),
+        experimental.clone(),
+        opt_out.clone(),
+        None,
+    );
+    let mut codec = Codec::default();
+    loop {
+        if gate.is_closed() {
+            return Ok(());
+        }
+        tokio::select! {
+            message = incoming.recv() => {
+                let Some(message) = message else { return Ok(()); };
+                if gate.is_closed() { return Ok(()); }
+                match codec.incoming(message)? {
+                    Input::Host(text) => {
+                        if text.len() > MAX_FRAME { return Err(io::Error::other("Remote Host frame too large")); }
+                        let mut result = None;
+                        gate.run(async { result = Some(timeout(IO_DEADLINE, sink.send(Message::Text(text.into()))).await); }).await;
+                        match result { Some(result) => result?.map_err(io::Error::other)?, None => return Ok(()) }
+                    }
+                    Input::Reply(message) => send(&outbound, message, gate)?,
+                }
+            }
+            frame = source.next() => {
+                if gate.is_closed() { return Ok(()); }
+                let frame = frame.ok_or_else(|| io::Error::other("Host disconnected"))?.map_err(io::Error::other)?;
+                let text = match frame {
+                    Message::Text(text) => text,
+                    Message::Close(_) => return Ok(()),
+                    Message::Ping(_) | Message::Pong(_) => continue,
+                    _ => return Err(io::Error::other("Host sent non-text frame")),
+                };
+                if let Some(message) = codec.outgoing(&text)? {
+                    initialized.store(codec.ready, Ordering::Release);
+                    experimental.store(codec.capabilities.experimental_api, Ordering::Release);
+                    *opt_out.write().map_err(|_| io::Error::other("capability lock poisoned"))? =
+                        codec.capabilities.opt_out_notification_methods.clone().unwrap_or_default().into_iter().collect();
+                    send(&outbound, message, gate)?;
+                }
+            }
+        }
+    }
+}
+
+fn send(
+    outbound: &OutboundConnectionState,
+    message: OutgoingMessage,
+    gate: &ConnectionRpcGate,
+) -> io::Result<()> {
+    if gate.is_closed() {
+        return Err(io::Error::other("Remote authentication closed"));
+    }
+    let message = filter_outgoing_message_for_connection(outbound, message);
+    if should_skip_notification_for_connection(outbound, &message) {
+        return Ok(());
+    }
+    outbound
+        .writer
+        .try_send(QueuedOutgoingMessage::new(message))
+        .map_err(|_| io::Error::other("Remote writer closed or overloaded"))
+}
