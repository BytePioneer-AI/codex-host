+#[tokio::test]
+async fn notification_opt_out_is_preserved() {
+    let (writer, mut rx) = mpsc::channel(2);
+    let opt_out = Arc::new(RwLock::new(HashSet::from([
+        "thread/name/updated".to_owned()
+    ])));
+    let outbound = OutboundConnectionState::new(
+        writer,
+        Arc::new(AtomicBool::new(true)),
+        Arc::new(AtomicBool::new(false)),
+        opt_out.clone(),
+        None,
+    );
+    let gate = ConnectionRpcGate::new();
+    let notification = || {
+        OutgoingMessage::AppServerNotification(serde_json::from_value(json!({"method":"thread/name/updated","params":{"threadId":"test","threadName":"renamed"}})).unwrap())
+    };
+    send(&outbound, notification(), &gate).unwrap();
+    assert!(rx.try_recv().is_err());
+    opt_out.write().unwrap().clear();
+    send(&outbound, notification(), &gate).unwrap();
+    assert!(rx.try_recv().is_ok());
+}
